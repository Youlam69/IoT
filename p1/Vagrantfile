# Part 1: two machines forming one K3s cluster.
#   aelyakouS   192.168.56.110   K3s server (controller)
#   aelyakouSW  192.168.56.111   K3s agent  (worker)

LOGIN     = "aelyakou"
SERVER_IP = "192.168.56.110"

MACHINES = {
  "#{LOGIN}S"  => { ip: SERVER_IP,        script: "scripts/server.sh" },
  "#{LOGIN}SW" => { ip: "192.168.56.111", script: "scripts/worker.sh" },
}

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_check_update = false

  # Passwordless SSH: Vagrant inserts a key per machine
  config.ssh.insert_key = true

  # Carries the K3s token from the server to the worker
  config.vm.synced_folder "shared", "/shared", create: true

  MACHINES.each do |name, m|
    config.vm.define name do |machine|
      machine.vm.hostname = name
      machine.vm.network "private_network", ip: m[:ip]

      machine.vm.provider "virtualbox" do |vb|
        vb.name   = name
        vb.cpus   = 1
        vb.memory = 1024
      end

      machine.vm.provision "shell", path: m[:script],
        env: { "NODE_IP" => m[:ip], "SERVER_IP" => SERVER_IP }
    end
  end
end
